# Harbor SDK backend staging env.
# Copy to .env.staging and fill with non-production staging values.
# This must mirror the staging Cloudflare resources, not production.

HARBOR_SDK_BACKEND_ENV=staging
HARBOR_SDK_BACKEND_PORT=8787

# Staging Cloudflare. Required when validating direct staging connectivity.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY_TOKEN=
CLOUDFLARE_AI_GATEWAY_ACCOUNT_ID=7a311013ab999497904c93fead14a26f
CLOUDFLARE_AI_GATEWAY_NAME=default
CLOUDFLARE_AI_GATEWAY_BASE_URL=https://gateway.ai.cloudflare.com/v1
CLOUDFLARE_TOKEN=

# Staging infrastructure ids. Keep these aligned with the Harbor staging
# Cloudflare resources.
D1_DATABASE_ID=
KV_NAMESPACE_ID=
R2_BUCKET_NAME=hbr3-staging-artifacts
QUEUE_NAME=hbr3-staging-events

# Staging app/service secrets.
SECRETS_ENCRYPTION_KEY=
INTERNAL_API_SECRET=
LIGHTHOUSE_API_SECRET=

# Staging auth and app URLs.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
WORKOS_WEBHOOK_SECRET=
WORKOS_ORGANIZATION_ID=
WORKOS_COOKIE_DOMAIN=stag.tryharbor.ai
WORKOS_COOKIE_MAX_AGE=604800
NEXT_PUBLIC_WORKOS_REDIRECT_URI=https://stag.tryharbor.ai/callback
HRBR_API_URL=https://stagapi.tryharbor.ai
API_BASE_URL=https://stagapi.tryharbor.ai

# Staging integrations.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OPENROUTER_API_KEY=
EXA_API_KEY=

# Staging observability.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_RATE=
NEXT_PUBLIC_SENTRY_SEND_USER_ID=
SENTRY_ORG=zonko-ai
SENTRY_PROJECT=harbor-web
SENTRY_AUTH_TOKEN=
HRBR_SENTRY_DSN=
HRBR_SENTRY_ENVIRONMENT=staging
HRBR_SENTRY_RELEASE=
HRBR_TELEMETRY_DISABLED=
