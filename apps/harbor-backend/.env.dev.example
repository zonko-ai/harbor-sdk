# Harbor SDK backend local development env.
# Copy to .env.dev for local runs. Do not put production values here.

HARBOR_SDK_BACKEND_ENV=dev
HARBOR_SDK_BACKEND_PORT=8787

# Local Harbor frontend/API proxy target.
HRBR_API_URL=http://localhost:8787
API_BASE_URL=http://localhost:8787

# Local internal service credential. Any non-empty value is fine for local dev.
INTERNAL_API_SECRET=local-dev-placeholder
LIGHTHOUSE_API_SECRET=local-dev-placeholder

# Staging Cloudflare coordinates can be present in dev for local parity, but
# the backend only treats them as staging-capability inputs.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY_TOKEN=
CLOUDFLARE_AI_GATEWAY_ACCOUNT_ID=7a311013ab999497904c93fead14a26f
CLOUDFLARE_AI_GATEWAY_NAME=default
CLOUDFLARE_AI_GATEWAY_BASE_URL=https://gateway.ai.cloudflare.com/v1
CLOUDFLARE_TOKEN=

D1_DATABASE_ID=
KV_NAMESPACE_ID=
R2_BUCKET_NAME=
QUEUE_NAME=

NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
HRBR_SENTRY_ENVIRONMENT=development
