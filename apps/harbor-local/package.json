  "dependencies": {
    "@hrbr/registry-catalog": "workspace:*",
    "@hrbr/sdk": "workspace:*"
  },
  "devDependencies": {
    "@hrbr/tsconfig": "workspace:*",
    "@hrbr/source-mcp": "workspace:*",
    "@types/bun": "^1.3.12",
    "typescript": "catalog:"
  }
}
