            {
              "kind": "option",
              "flag": "--commit",
              "path": "commit",
              "omit_if_empty": true
            },
            {
              "kind": "option",
              "flag": "--created",
              "path": "created",
              "omit_if_empty": true
            },
            {
              "kind": "option",
              "flag": "--event",
              "path": "event",
              "omit_if_empty": true
            },
            {
              "kind": "option",
              "flag": "--jq",
              "path": "jq",
              "omit_if_empty": true
            },
            {
              "kind": "option",
              "flag": "--json",
              "path": "json",
              "omit_if_empty": true
            },
            {
              "kind": "option",
              "flag": "--limit",
              "path": "limit",
              "omit_if_empty": true
            },
            {
              "kind": "option",
              "flag": "--status",
              "path": "status",
              "omit_if_empty": true
            },
            {
              "kind": "option",
              "flag": "--template",
              "path": "template",
              "omit_if_empty": true
            },
            {
              "kind": "option",
              "flag": "--user",
