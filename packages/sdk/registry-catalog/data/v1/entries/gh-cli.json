            },
            "repo": {
              "type": "string",
              "description": "Select another repository using the [HOST/]OWNER/REPO format"
            }
          },
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object"
        },
        "tags": [
          "read"
        ],
        "binding": {
          "kind": "cli_command",
          "tool_name": "issue_view",
          "argv_template": [
            {
              "kind": "literal",
              "value": "issue"
            },
            {
              "kind": "literal",
