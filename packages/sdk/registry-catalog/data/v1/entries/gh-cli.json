            },
            {
              "kind": "option",
              "flag": "--template",
              "path": "template",
              "omit_if_empty": true
            },
            {
              "kind": "flag",
              "flag": "--verbose",
              "path": "verbose"
            },
            {
              "kind": "flag",
              "flag": "--web",
              "path": "web"
            },
            {
              "kind": "option",
              "flag": "--repo",
              "path": "repo",
              "omit_if_empty": true
            },
            {
              "kind": "literal",
              "value": "--json"
            },
            {
              "kind": "literal",
              "value": "databaseId,name,status,conclusion,workflowName,displayTitle,createdAt,url,jobs"
