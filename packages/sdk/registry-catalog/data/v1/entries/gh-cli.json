              "path": "exit_status"
            },
            {
              "kind": "option",
              "flag": "--job",
              "path": "job",
              "omit_if_empty": true
            },
            {
              "kind": "option",
              "flag": "--jq",
              "path": "jq",
              "omit_if_empty": true
            },
            {
              "kind": "option",
              "flag": "--json",
              "path": "json",
              "omit_if_empty": true
            },
            {
              "kind": "flag",
              "flag": "--log",
              "path": "log"
            },
            {
              "kind": "flag",
              "flag": "--log-failed",
