{
  "slug": "browserbase-mcp",
  "display_name": "Browserbase MCP",
  "description": "Cloud browser automation via MCP",
  "category": "web",
  "kind": "mcp",
  "config": {
    "mcp_endpoint": "https://mcp.browserbase.com/mcp",
    "mcp_transport": "http"
  },
  "auth": {
    "method": "query",
    "query_param": "browserbaseApiKey",
    "required_secrets": [
      "BROWSERBASE_API_KEY"
    ]
  },
  "default_namespace": "browserbase-mcp"
}
