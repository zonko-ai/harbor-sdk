{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryharbor.ai/schemas/orbit-ui/feedback-board.config.schema.json",
  "title": "Feedback Board Template Config",
  "description": "Configuration for an Orbit UI feedback board app with an intake form and listed submissions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "jobs"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,127}$", "default": "feedback-board" },
    "description": { "type": "string", "maxLength": 240 },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "eyebrow": { "type": "string", "maxLength": 48, "default": "feedback" },
    "intro": { "type": "string", "maxLength": 320 },
    "boardPath": { "type": "string", "pattern": "^/.*$", "default": "/" },
    "auth": { "enum": ["public", "workspace_member"], "default": "public" },
    "submitLabel": { "type": "string", "maxLength": 48, "default": "Submit" },
    "thanksTitle": { "type": "string", "maxLength": 120, "default": "Thanks — we have it." },
    "thanksMessage": { "type": "string", "maxLength": 320 },
    "footer": { "type": "string", "maxLength": 180 },
    "jobs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submit", "list"],
      "properties": {
        "submit": { "$ref": "#/$defs/jobRef" },
        "list": { "$ref": "#/$defs/jobRef" }
      }
    },
    "submitField": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$", "default": "body" },
        "label": { "type": "string", "maxLength": 80, "default": "Your feedback" },
        "placeholder": { "type": "string", "maxLength": 160 },
        "help": { "type": "string", "maxLength": 180 },
        "required": { "type": "boolean", "default": true },
        "minLength": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 3 },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 2000 },
        "rows": { "type": "integer", "minimum": 2, "maximum": 12, "default": 4 }
      }
    },
    "nameField": { "$ref": "#/$defs/optionalField" },
    "emailField": { "$ref": "#/$defs/optionalField" },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "maxLength": 80, "default": "Recent feedback" },
        "eyebrow": { "type": "string", "maxLength": 48, "default": "recent" },
        "emptyMessage": { "type": "string", "maxLength": 180 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 },
        "showSource": { "type": "boolean", "default": true },
        "showDate": { "type": "boolean", "default": true }
      }
    }
  },
  "$defs": {
    "jobRef": {
      "oneOf": [
        { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,127}$" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,127}$" },
            "version": { "type": "string", "pattern": "^v[1-9][0-9]*$" }
          }
        }
      ]
    },
    "optionalField": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "label": { "type": "string", "maxLength": 80 },
        "placeholder": { "type": "string", "maxLength": 160 }
      }
    }
  }
}
