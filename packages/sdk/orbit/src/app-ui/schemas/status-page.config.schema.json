{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://examples.tryharbor.ai/orbit-ui/v2/status-page.config.schema.json",
  "title": "orbit.ui status-page template config",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "sections"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Main page title shown in the hero and document title."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280,
      "description": "Short hero description and meta description."
    },
    "eyebrow": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Small uppercase label above the hero title."
    },
    "entriesField": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "default": ".",
      "description": "Field in the list-job result that contains section arrays. Use '.' or omit for top-level keys."
    },
    "emptyLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140,
      "description": "Default empty state copy for sections without entries."
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/definitions/section" },
      "description": "Status sections. Each section key maps to an array returned by the list job."
    }
  },
  "definitions": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "Key used to read this section's entries from the list-job result."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Section title."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220,
          "description": "Optional explanatory text under the section title."
        },
        "emptyLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Section-specific empty state copy."
        }
      }
    },
    "statusEntryShape": {
      "type": "object",
      "description": "Expected list-job entry shape; documented for template authors, not used to validate config.",
      "properties": {
        "title": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "summary": { "type": "string" },
        "status": { "type": "string" },
        "href": { "type": "string", "format": "uri-reference" },
        "timestamp": { "type": "string" },
        "updated_at": { "type": "string" },
        "meta": { "type": "object" }
      }
    }
  },
  "examples": [
    {
      "title": "Launch status",
      "description": "A read-only view of what shipped, what is deploying, and what is queued.",
      "eyebrow": "Status",
      "entriesField": ".",
      "sections": [
        { "key": "released", "title": "Released" },
        { "key": "deploying", "title": "Deploying" },
        { "key": "queued", "title": "Queued" }
      ]
    }
  ]
}
