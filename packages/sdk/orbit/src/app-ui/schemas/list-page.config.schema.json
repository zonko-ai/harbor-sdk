{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tryharbor.ai/schemas/orbit-ui/list-page.config.schema.json",
  "title": "Orbit UI List Page Template Config",
  "description": "Configuration for a generic read-only Orbit App listing page backed by one list job.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "columns", "jobs"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Optional Orbit App name. Defaults to a slug generated from title.",
      "pattern": "^[a-z][a-z0-9-]{0,127}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 300
    },
    "eyebrow": {
      "type": "string",
      "maxLength": 80
    },
    "emptyMessage": {
      "type": "string",
      "maxLength": 200,
      "default": "Nothing here yet."
    },
    "columns": {
      "type": "array",
      "description": "Columns rendered for each item. The first column becomes the card heading; remaining columns become metadata rows.",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label"],
        "properties": {
          "key": {
            "type": "string",
            "description": "Item field path. Dot paths such as customer.email are supported.",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9_$-]+(\\.[A-Za-z0-9_$-]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "type": {
            "type": "string",
            "enum": ["text", "date", "badge"],
            "default": "text"
          }
        }
      }
    },
    "jobs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["list"],
      "properties": {
        "list": {
          "type": "string",
          "description": "Published Harbor job name used by GET / to fetch list items.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9-]{0,127}$"
        }
      }
    }
  },
  "examples": [
    {
      "name": "customer-list",
      "title": "Customers",
      "description": "Recent customers from the workspace system of record.",
      "columns": [
        { "key": "name", "label": "Name" },
        { "key": "status", "label": "Status", "type": "badge" },
        { "key": "created_at", "label": "Created", "type": "date" }
      ],
      "jobs": { "list": "customer-list" }
    }
  ]
}
