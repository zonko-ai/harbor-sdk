{
  "name": "@hrbr/client",
  "version": "0.1.1",
  "private": false,
  "description": "Promise-first Harbor API client with an explicit Effect-native subpath.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zonko-ai/harbor-sdk.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/zonko-ai/harbor-sdk#readme",
  "bugs": {
    "url": "https://github.com/zonko-ai/harbor-sdk/issues"
  },
  "keywords": [
    "api-client",
    "harbor",
    "hrbr",
    "mcp",
    "sdk"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./auth": {
      "types": "./dist/auth.d.mts",
      "import": "./dist/auth.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    },
    "./effect": {
      "types": "./dist/effect.d.mts",
      "import": "./dist/effect.mjs"
    },
    "./promise": {
      "types": "./dist/promise.d.mts",
      "import": "./dist/promise.mjs"
    },
    "./generated/harbor": {
      "types": "./dist/generated/harbor.d.mts",
      "import": "./dist/generated/harbor.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {},
  "peerDependencies": {
    "effect": "4.0.0-beta.70"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  }
}
