{
  "name": "harbor-sdk",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/sdk/*",
    "examples/*"
  ],
  "scripts": {
    "typecheck": "bun run typecheck:packages && bun run typecheck:examples && bun run typecheck:apps",
    "typecheck:packages": "bun run --filter '@hrbr/*' typecheck",
    "typecheck:examples": "bun run --filter './examples/*' typecheck",
    "typecheck:apps": "bun run --filter './apps/*' typecheck",
    "test": "bun test packages/sdk/*/test packages/workflows/test",
    "docs:api": "typedoc --options typedoc.json",
    "example:custom-source": "bun run examples/sdk-custom-source/src/index.ts",
    "example:tool-catalog": "bun run examples/sdk-tool-catalog/src/index.ts",
    "example:orbit-runtime": "bun run examples/sdk-orbit-runtime/src/index.ts",
    "example:platform-runtime": "bun run examples/sdk-platform-runtime/src/index.ts",
    "example:linear-notion": "bun run examples/tool-registry-linear-notion/src/index.ts",
    "example:linear-mcp-local": "bun run examples/plugin-linear-mcp-local/src/index.ts",
    "example:notion-mcp-local": "bun run examples/plugin-notion-mcp-local/src/index.ts"
  },
  "catalog": {
    "effect": "4.0.0-beta.64",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typedoc": "^0.28.19",
    "typescript": "catalog:"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
